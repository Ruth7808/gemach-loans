generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Borrower {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  phone        String
  email        String?
  address      String?
  notes        String?
  createdAt    DateTime      @default(now())
  loans        Loan[]
  payments     Payment[]
  loanRequests LoanRequest[]
}

model Loan {
  id              Int           @id @default(autoincrement())
  borrowerId      Int
  amount          Float
  givenDate       DateTime
  numInstallments Int
  status          String        @default("active")
  notes           String?
  createdAt       DateTime      @default(now())
  borrower        Borrower      @relation(fields: [borrowerId], references: [id])
  installments    Installment[]
  payments        Payment[]
  loanRequest     LoanRequest?
}

model Installment {
  id          Int          @id @default(autoincrement())
  loanId      Int
  number      Int
  dueDate     DateTime
  amount      Float
  paid        Float        @default(0)
  status      String       @default("pending")
  loan        Loan         @relation(fields: [loanId], references: [id])
  allocations Allocation[]
}

model Payment {
  id          Int          @id @default(autoincrement())
  loanId      Int
  borrowerId  Int
  paymentDate DateTime
  amount      Float
  notes       String?
  createdAt   DateTime     @default(now())
  loan        Loan         @relation(fields: [loanId], references: [id])
  borrower    Borrower     @relation(fields: [borrowerId], references: [id])
  allocations Allocation[]
}

model Allocation {
  id              Int         @id @default(autoincrement())
  paymentId       Int
  installmentId   Int
  allocatedAmount Float
  payment         Payment     @relation(fields: [paymentId], references: [id])
  installment     Installment @relation(fields: [installmentId], references: [id])
}

model Setting {
  key   String @id
  value String
}

model Depositor {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  deposits  Deposit[]
  withdrawalRequests WithdrawalRequest[]
  withdrawals        Withdrawal[]
}

model Deposit {
  id          Int       @id @default(autoincrement())
  depositorId Int
  amount      Float
  date        DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  depositor   Depositor @relation(fields: [depositorId], references: [id])
}

model WithdrawalRequest {
  id          Int          @id @default(autoincrement())
  depositorId Int
  amount      Float
  requestDate DateTime
  targetDate  DateTime
  status      String       @default("open")
  paidSoFar   Float        @default(0)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  depositor   Depositor    @relation(fields: [depositorId], references: [id])
  withdrawals Withdrawal[]
}

model Withdrawal {
  id                  Int                @id @default(autoincrement())
  withdrawalRequestId Int?
  depositorId         Int
  amount              Float
  date                DateTime
  notes               String?
  createdAt           DateTime           @default(now())
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])
  depositor           Depositor          @relation(fields: [depositorId], references: [id])
}

model LoanRequest {
  id              Int       @id @default(autoincrement())
  source          String    @default("manual") // manual | fillout
  externalId      String?
  borrowerId      Int?
  nameAsEntered   String
  phoneAsEntered  String
  amount          Float
  numInstallments Int?
  notes           String?
  rawFormData     String?
  status          String    @default("pending") // pending | rejected | converted
  loanId          Int?      @unique
  requestDate     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  borrower        Borrower? @relation(fields: [borrowerId], references: [id])
  loan            Loan?     @relation(fields: [loanId], references: [id])
}
